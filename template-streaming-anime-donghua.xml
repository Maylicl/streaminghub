    // Search Functions
    document.getElementById('searchInput').addEventListener('input', function(e) {
        const query = e.target.value.toLowerCase();
        if (query.length > 2) {
            performSearch(query);
        } else {
            document.getElementById('searchResults').style.display = 'none';
        }
    });
    
    function performSearch(query) {
        // Simulate search results
        const results = [
            { title: 'Solo Leveling Season 2', type: 'Anime', episode: 'Episode 12' },
            { title: 'Mo Dao Zu Shi', type: 'Donghua', episode: 'Season 3' },
            { title: 'Attack on Titan', type: 'Anime', episode: 'Final Season' }
        ];
        
        const resultsContainer = document.getElementById('searchResults');
        resultsContainer.innerHTML = '';
        
        results.forEach(result => {
            const resultItem = document.createElement('div');
            resultItem.className = 'search-result-item';
            resultItem.innerHTML = `
                <div class='search-result-title'>${result.title}</div>
                <div class='search-result-meta'>${result.type} • ${result.episode}</div>
            `;
            resultsContainer.appendChild(resultItem);
        });
        
        resultsContainer.style.display = 'block';
    }
    
    // Hide search results when clicking outside
    document.addEventListener('click', function(e) {
        if (!e.target.closest('.search-container')) {
            document.getElementById('searchResults').style.display = 'none';
        }
    });
    
    // Mobile Menu Toggle
    document.getElementById('mobileMenuToggle').addEventListener('click', function() {
        document.getElementById('navMenu').classList.toggle('active');
    });
    
    // Header Scroll Effect
    window.addEventListener('scroll', function() {
        const header = document.getElementById('header');
        if (window.scrollY > 100) {
            header.classList.add('scrolled');
        } else {
            header.classList.remove('scrolled');
        }
    });
    
    // Video Player Functions
    function switchServer(serverId) {
        // Remove active class from all server buttons
        document.querySelectorAll('.server-btn').forEach(btn => {
            btn.classList.remove('active');
        });
        
        // Add active class to clicked button
        event.target.classList.add('active');
        
        // Switch video source
        console.log('Switching to server:', serverId);
        // Implement video source switching logic here
    }
    
    // Bookmark Function
    function toggleBookmark(animeId, title) {
        let bookmarks = JSON.parse(localStorage.getItem('bookmarks') || '[]');
        const index = bookmarks.findIndex(item => item.id === animeId);
        
        if (index > -1) {
            bookmarks.splice(index, 1);
            alert('Dihapus dari bookmark');
        } else {
            bookmarks.push({ id: animeId, title: title, date: new Date().toISOString() });
            alert('Ditambahkan ke bookmark');
        }
        
        localStorage.setItem('bookmarks', JSON.stringify(bookmarks));
    }
    
    // Watch History
    function addToHistory(animeId, title, episode) {
        let history = JSON.parse(localStorage.getItem('watchHistory') || '[]');
        const newEntry = { 
            id: animeId, 
            title: title, 
            episode: episode, 
            date: new Date().toISOString(),
            timestamp: Date.now()
        };
        
        // Remove existing entry if any
        history = history.filter(item => !(item.id === animeId && item.episode === episode));
        
        // Add new entry at the beginning
        history.unshift(newEntry);
        
        // Keep only last 50 entries
        history = history.slice(0, 50);
        
        localStorage.setItem('watchHistory', JSON.stringify(history));
    }
    
    // Anti-bot Protection
    function checkBotBehavior() {
        if (!antiBotEnabled) return;
        
        // Check for suspicious behavior
        const clickCount = parseInt(sessionStorage.getItem('clickCount') || '0');
        const startTime = parseInt(sessionStorage.getItem('sessionStart') || Date.now().toString());
        const currentTime = Date.now();
        const sessionDuration = currentTime - startTime;
        
        // If too many clicks in short time, likely a bot
        if (clickCount > 50 && sessionDuration < 30000) {
            alert('Aktivitas mencurigakan terdeteksi. Silahkan refresh halaman.');
            window.location.reload();
        }
        
        sessionStorage.setItem('clickCount', (clickCount + 1).toString());
    }
    
    // Track user clicks
    document.addEventListener('click', checkBotBehavior);
    
    // Initialize session
    if (!sessionStorage.getItem('sessionStart')) {
        sessionStorage.setItem('sessionStart', Date.now().toString());
        sessionStorage.setItem('clickCount', '0');
    }
    
    // Lazy Loading for Images
    function lazyLoadImages() {
        const images = document.querySelectorAll('img[data-src]');
        const imageObserver = new IntersectionObserver((entries, observer) => {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    const img = entry.target;
                    img.src = img.dataset.src;
                    img.classList.remove('lazy');
                    imageObserver.unobserve(img);
                }
            });
        });
        
        images.forEach(img => imageObserver.observe(img));
    }
    
    // Initialize lazy loading
    document.addEventListener('DOMContentLoaded', lazyLoadImages);
    
    // Smooth Scrolling
    document.querySelectorAll('a[href^="#"]').forEach(anchor => {
        anchor.addEventListener('click', function (e) {
            e.preventDefault();
            const target = document.querySelector(this.getAttribute('href'));
            if (target) {
                target.scrollIntoView({
                    behavior: 'smooth',
                    block: 'start'
                });
            }
        });
    });
    
    // Back to Top Button
    const backToTopButton = document.createElement('button');
    backToTopButton.innerHTML = '<i class="fas fa-arrow-up"></i>';
    backToTopButton.className = 'btn btn-primary';
    backToTopButton.style.cssText = `
        position: fixed;
        bottom: 2rem;
        right: 2rem;
        z-index: 999;
        display: none;
        border-radius: 50%;
        width: 50px;
        height: 50px;
        padding: 0;
    `;
    
    document.body.appendChild(backToTopButton);
    
    window.addEventListener('scroll', function() {
        if (window.pageYOffset > 300) {
            backToTopButton.style.display = 'block';
        } else {
            backToTopButton.style.display = 'none';
        }
    });
    
    backToTopButton.addEventListener('click', function() {
        window.scrollTo({
            top: 0,
            behavior: 'smooth'
        });
    });
    
    // Console Warning
    console.log('%cSTOP!', 'color: red; font-size: 50px; font-weight: bold;');
    console.log('%cThis is a browser feature intended for developers. Please don\'t paste any code here that you don\'t understand.', 'color: white; font-size: 16px;');
    console.log('%cPaste any malicious code here could lead to your account being compromised!', 'color: red; font-size: 16px;');
    </script>
    
    <!-- Disqus Thread -->
    <b:if cond='data:blog.pageType == &quot;item&quot;'>
        <div class='container'>
            <div class='comments-section' style='margin: 3rem 0;'>
                <div id='disqus_thread'></div>
                <script type='text/javascript'>
                var disqus_loaded = false;
                function load_disqus() {
                    if (!disqus_loaded) {
                        disqus_loaded = true;
                        var d = document, s = d.createElement('script');
                        s.src = 'https://your-disqus-shortname.disqus.com/embed.js';
                        s.setAttribute('data-timestamp', +new Date());
                        (d.head || d.body).appendChild(s);
                    }
                }
                
                // Load disqus when comments section is visible
                var commentsSection = document.querySelector('.comments-section');
                if (commentsSection) {
                    var disqusObserver = new IntersectionObserver(function(entries) {
                        entries.forEach(function(entry) {
                            if (entry.isIntersecting) {
                                load_disqus();
                                disqusObserver.unobserve(commentsSection);
                            }
                        });
                    });
                    disqusObserver.observe(commentsSection);
                }
                </script>
            </div>
        </div>
    </b:if>
