    // NSFW Warning Functions
    function checkNSFWContent(labels) {
        return labels.some(label => nsfwTags.includes(label.toLowerCase()));
    }
    
    function showNSFWWarning(postTitle, labels) {
        const nsfwTagsFound = labels.filter(label => nsfwTags.includes(label.toLowerCase()));
        document.getElementById('nsfwTagList').textContent = nsfwTagsFound.join(', ');
